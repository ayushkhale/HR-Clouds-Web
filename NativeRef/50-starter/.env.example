# Copy to .env.development and .env.production. Both are gitignored.
# react-native-config compiles these into the native build, so a change needs
# a rebuild, not a Metro reload.

APP_ENV=development
API_BASE_URL=https://development.hrclouds.in/api/v1

# Google SSO
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Maya (the Ask Maya assistant). Leave blank to hide Maya entirely.
DOCMIND_API_KEY=
DOCMIND_API_URL=https://api.codewithrishi.fun/api/public

APP_VERSION=1.0.0
SENTRY_DSN=
